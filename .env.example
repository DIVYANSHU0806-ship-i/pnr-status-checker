# Backend Configuration
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://localhost:27017/pnr-status-checker

# Mock Data (set to true to use mock data, false to use real API)
USE_MOCK_DATA=true

# IRCTC API Configuration (optional - only if you have real API key)
IRCTC_API_KEY=your_actual_key
IRCTC_API_URL=https://api.irctc.co.in/v1

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10