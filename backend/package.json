{
  "name": "pnr-status-checker-backend",
  "version": "1.0.0",
  "description": "Production-ready Backend API for PNR status checker with IRCTC integration",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --detectOpenHandles --testTimeout=10000",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": ["pnr", "railway", "irctc", "ticket", "status", "express", "mongodb"],
  "author": "",
  "license": "MIT",
  "engines": {"node": ">=16.0.0"},
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "dotenv": "^16.3.1",
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^6.10.0",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "express-validator": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0"
  }
}