# Backend Environment Configuration
NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/pnr-status-checker

# Mock Data Mode (set true to use mock data, false to use real IRCTC API)
USE_MOCK_DATA=true

# IRCTC API Configuration (optional)
IRCTC_API_KEY=
IRCTC_API_URL=https://api.irctc.co.in/v1

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10